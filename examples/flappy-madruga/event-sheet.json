{
  "format": "impossible.event-sheet",
  "version": 1,
  "execution": {
    "tick": "source_frame",
    "delta_seconds": "source_dt",
    "event_order": "source_tree",
    "action_order": "declaration"
  },
  "events": [
    {
      "id": "c2-chaves-layout-start",
      "name": "Chaves layout: set the level threshold and pipe skin",
      "source": {
        "repository": "danimesq/Flappy-Ramon",
        "path": "Event sheets/Chaves.xml",
        "event_sid": "9305905589121505",
        "migration_status": "source_derived_unverified"
      },
      "trigger": { "kind": "on_layout_start" },
      "actions": [
        {
          "kind": "set",
          "target": "game.Required_Score",
          "value": { "const": 10 }
        },
        {
          "kind": "set_animation",
          "target": "TopPipe",
          "animation": "Chaves",
          "from_frame": 1
        },
        {
          "kind": "set_animation",
          "target": "BottomPipe",
          "animation": "Chaves",
          "from_frame": 1
        }
      ]
    },
    {
      "id": "c2-common-game-layout-start",
      "name": "Common in-game: reset per-layout gameplay values",
      "source": {
        "repository": "danimesq/Flappy-Ramon",
        "path": "Event sheets/Common in-game.xml",
        "event_sid": "2246972820014324",
        "migration_status": "source_derived_unverified"
      },
      "trigger": { "kind": "on_layout_start" },
      "actions": [
        {
          "kind": "set",
          "target": "Madruga.Queda",
          "value": { "const": false }
        },
        {
          "kind": "set",
          "target": "game.Score",
          "value": { "const": 0 }
        },
        {
          "kind": "set",
          "target": "game.SCROLLSPEED",
          "value": { "const": 300 }
        },
        {
          "kind": "set",
          "target": "game.SECONDSPEROBSTACLE",
          "value": { "const": 1 }
        },
        {
          "kind": "set_x",
          "target": "TiledBackground2",
          "value": { "const": 0 }
        },
        {
          "kind": "set_x",
          "target": "TiledBackground",
          "value": { "const": 0 }
        }
      ]
    },
    {
      "id": "c2-background-and-pipe-scroll",
      "name": "Background group: move pipes and tiled backgrounds every tick",
      "source": {
        "repository": "danimesq/Flappy-Ramon",
        "path": "Event sheets/Common in-game.xml",
        "event_sid": "1385689931601852",
        "migration_status": "source_derived_unverified"
      },
      "trigger": { "kind": "every_tick" },
      "actions": [
        {
          "kind": "set_x",
          "target": "BottomPipe",
          "value": {
            "sub": [
              { "ref": "BottomPipe.X" },
              {
                "mul": [
                  { "ref": "game.SCROLLSPEED" },
                  { "ref": "clock.source_dt" }
                ]
              }
            ]
          }
        },
        {
          "kind": "set_x",
          "target": "TopPipe",
          "value": {
            "sub": [
              { "ref": "TopPipe.X" },
              {
                "mul": [
                  { "ref": "game.SCROLLSPEED" },
                  { "ref": "clock.source_dt" }
                ]
              }
            ]
          }
        },
        {
          "kind": "set_x",
          "target": "TiledBackground2",
          "value": {
            "sub": [
              { "ref": "TiledBackground2.X" },
              {
                "mul": [
                  { "ref": "game.SCROLLSPEED" },
                  { "ref": "clock.source_dt" }
                ]
              }
            ]
          }
        },
        {
          "kind": "set_x",
          "target": "TiledBackground",
          "value": {
            "sub": [
              { "ref": "TiledBackground.X" },
              {
                "mul": [
                  { "ref": "game.SCROLLSPEED" },
                  { "ref": "clock.source_dt" }
                ]
              }
            ]
          }
        }
      ]
    }
  ]
}
