      "revision": "aab10559cea2d1283eafa2a8792aaf877cbffcf5",
      "project_file": "source/legacy-construct2/Flappy Madruga.caproj",
      "project_version": "0.6.1.6",
      "saved_with_version": 21400
    },
    "source_model": "source-model.json",
    "source_coverage": "event-sheets/source-coverage.json",
    "migration_manifest": "migration-manifest.json",
    "asset_manifest": "asset-placeholders.json",
    "build": {
      "cargo_workspace": "../../..",
      "cargo_manifest": "Cargo.toml",
      "cargo_package": "flappy-madruga",
      "logic_target": "headless-rust-library",
      "graphics": "deferred-to-RustMultiConsoleFoundation",
      "entrypoint": "src/lib.rs"
    },
    "logical_resolution": {
      "width": 400,
      "height": 500,
      "orientation": "portrait"
    },
    "layouts": [
      {
        "name": "Start",
        "event_sheet": "sheet-start",
        "includes": []
      },
      {
        "name": "Continuous",
        "event_sheet": "sheet-continuous",
        "includes": [
          "sheet-common-game"
        ]
      },
      {
        "name": "Chaves",
        "event_sheet": "sheet-chaves",
        "includes": [
          "sheet-common-game",
          "sheet-common-levels"
        ]
      }
    ],
    "global_variables": {
      "JumpStrength": {
        "type": "number",
        "initial": 500,
        "constant": true
      },
      "SCROLLSPEED": {
        "type": "number",
        "initial": 150,
        "comment": "pixels per second; set to 300 on layout start"
      },
      "SECONDSPEROBSTACLE": {
        "type": "number",
        "initial": 1,
        "set_on_layout_start": 1
      },
      "Score": {
        "type": "number",
        "initial": 0
      },
      "Required_Score": {
        "type": "number",
        "initial": 0,
        "set_on_chaves_layout_start": 10
      },
      "Layout_Name": {
        "type": "text",
        "initial": ""
      }
    },
    "runtime_semantics": {
      "event_group_order": [
        "Start",
        "Movement",
        "Collisions",
        "Scoring",
        "Background",
        "Obstacle"
      ],
      "time_source": "the source editor per-frame dt, sampled once per host frame",
      "initial_pipe_instances_destroyed_on_layout_start": true,
      "first_pipe_spawn_seconds": 1,
      "pipe_pair": {
        "x": 440,
        "gap_y_distance": 750,
        "random_top_y_bounds": [
          -250,
          -70
        ]
      },
      "score_condition": "BottomPipe.X <= Madruga.X AND NOT BottomPipe.Scored",
      "score_increment": 1,
      "high_score_key": "Highscore",
      "retry_wait_seconds": 0.1,
      "flying_animation_wait_seconds": 0.5,
      "top_pipe_game_over_wait_seconds": 0.5,
      "layout_order": [
        "Start",
        "Continuous",
        "Chaves"
      ],
      "root_event_sections_after_groups": [
        "Restart"
      ],
      "chaves_pipe_animation_action": "applies to editor-time pipe instances during the Chaves layout-start event pass; Common-in-game has already queued those instances for destruction; subsequently spawned pipe pairs use Default animation pending differential verification",
      "maximum_dt_seconds": 0.03333333333333333,
      "delta_time_policy": "source Every-tick and Platform movement use min(host_frame_dt, 1/30); System Every-X-seconds and Wait continuations consume elapsed time independently"
    },
    "import_notes": [
      "The .ieproj file is a native ImpossibleEngine project container, not the original Construct 2 file.",
      "Immutable upstream source snapshots are kept under source/legacy-construct2/.",
      "The logic target compiles the platform-neutral Rust game model without building a renderer or opening a window.",
      "Original media bytes and Foundation graphics integration remain outside this headless logic build."
    ]
