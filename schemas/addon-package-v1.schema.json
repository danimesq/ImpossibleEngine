{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImpossibleEngine Third-Party Add-on Package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "manifestVersion",
    "addon"
  ],
  "properties": {
    "format": {
      "const": "impossible.addon-package"
    },
    "manifestVersion": {
      "const": 1
    },
    "addon": {
      "$ref": "addon-registry-v1.schema.json#/$defs/addon"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entrypoints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "editor": {
              "type": [
                "string",
                "null"
              ]
            },
            "runtime": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
