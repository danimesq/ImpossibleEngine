{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImpossibleEngine Add-on Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "registryVersion",
    "engineCompatibility",
    "aceModel",
    "addons"
  ],
  "properties": {
    "format": {
      "const": "impossible.addon-registry"
    },
    "registryVersion": {
      "const": 1
    },
    "engineCompatibility": {
      "type": "string"
    },
    "aceModel": {
      "type": "object",
      "required": [
        "sections",
        "executionKinds",
        "parameterTypes"
      ],
      "properties": {
        "sections": {
          "type": "array"
        },
        "executionKinds": {
          "type": "array"
        },
        "parameterTypes": {
          "type": "array"
        },
        "conditionFlags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "addons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/addon"
      }
    }
  },
  "$defs": {
    "parameter": {
      "type": "object",
      "required": [
        "name",
        "label",
        "description",
        "type",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "default": {},
        "options": {
          "type": "array"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        }
      }
    },
    "ace": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description",
        "execution",
        "parameters",
        "selection",
        "ui"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "execution": {
          "enum": [
            "trigger",
            "predicate",
            "command",
            "pure"
          ]
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "selection": {
          "type": "string"
        },
        "returns": {
          "type": "string"
        },
        "writes": {
          "type": "array"
        },
        "ui": {
          "type": "object",
          "properties": {
            "markers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "flags": {
              "type": "object",
              "required": [
                "trigger",
                "fake_trigger",
                "static",
                "looping",
                "invertible",
                "incompatible_with_triggers",
                "deprecated",
                "highlight"
              ],
              "properties": {
                "trigger": {
                  "type": "boolean"
                },
                "fake_trigger": {
                  "type": "boolean"
                },
                "static": {
                  "type": "boolean"
                },
                "looping": {
                  "type": "boolean"
                },
                "invertible": {
                  "type": "boolean"
                },
                "incompatible_with_triggers": {
                  "type": "boolean"
                },
                "deprecated": {
                  "type": "boolean"
                },
                "highlight": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "sourceCompatibility": {
          "type": "object",
          "description": "Optional verified source ACE and positional parameter identifiers."
        }
      }
    },
    "addon": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "version",
        "name",
        "category",
        "description",
        "icon",
        "editor",
        "provides",
        "requires",
        "properties",
        "conditions",
        "actions",
        "expressions",
        "implementation",
        "author",
        "documentation",
        "object",
        "isDeprecated"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(plugin|behavior|effect)\\."
        },
        "kind": {
          "enum": [
            "plugin",
            "behavior",
            "effect"
          ]
        },
        "version": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "icon": {
          "type": "object"
        },
        "editor": {
          "type": "object"
        },
        "provides": {
          "type": "array"
        },
        "requires": {
          "type": "array"
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ace"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ace"
          }
        },
        "expressions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ace"
          }
        },
        "render": {
          "type": "object",
          "properties": {
            "isDeprecated": {
              "type": "boolean"
            }
          }
        },
        "implementation": {
          "type": "object",
          "required": [
            "status",
            "engine_runtime",
            "host_adapter_required",
            "notes"
          ],
          "properties": {
            "status": {
              "const": "specification_only"
            },
            "engine_runtime": {
              "const": false
            },
            "host_adapter_required": {
              "type": "array"
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "documentation": {
          "type": "string",
          "minLength": 1
        },
        "object": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "placement",
            "rotatable",
            "single_instance"
          ],
          "properties": {
            "kind": {
              "type": "string"
            },
            "placement": {
              "type": "string"
            },
            "rotatable": {
              "type": "boolean"
            },
            "single_instance": {
              "type": "boolean"
            }
          }
        },
        "isDeprecated": {
          "type": "boolean"
        },
        "audioProcessing": {
          "type": "object",
          "description": "Optional per-tag audio signal-processing metadata, separate from visual render effects."
        },
        "legacyCompatibility": {
          "type": "object",
          "description": "Optional verified source-version aliases. Do not infer compatibility from display names."
        }
      },
      "additionalProperties": false
    }
  }
}
