{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImpossibleEngine Typed Event Sheet v1",
  "description": "Proposed typed Event Sheet format. Compiler and scheduling semantics are specified in docs/EVENT-SHEETS-JSON-TO-RUST.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "execution", "events"],
  "properties": {
    "format": { "const": "impossible.event-sheet" },
    "version": { "const": 1 },
    "execution": { "$ref": "#/$defs/execution" },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tick", "delta_seconds", "event_order", "action_order"],
      "properties": {
        "tick": { "enum": ["source_frame", "fixed"] },
        "delta_seconds": { "enum": ["source_dt", "fixed_delta"] },
        "event_order": { "const": "source_tree" },
        "action_order": { "const": "declaration" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "path", "event_sid", "migration_status"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "event_sid": { "type": "string", "minLength": 1 },
        "migration_status": {
          "enum": ["source_derived_unverified", "exact_mapping_tested", "mapped_with_constraints", "preserved_unsupported"]
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "source", "trigger", "actions"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean", "default": true },
        "source": { "$ref": "#/$defs/source" },
        "trigger": { "$ref": "#/$defs/trigger" },
        "conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/condition" }
        },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/action" }
        },
        "subevents": {
          "type": "array",
          "items": { "$ref": "#/$defs/event" }
        }
      }
    },
    "trigger": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "on_layout_start" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "every_tick" } }
        }
      ]
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "op", "left", "right"],
          "properties": {
            "kind": { "const": "compare" },
            "op": { "enum": ["eq", "ne", "lt", "lte", "gt", "gte"] },
            "left": { "$ref": "#/$defs/expression" },
            "right": { "$ref": "#/$defs/expression" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "condition"],
          "properties": {
            "kind": { "const": "not" },
            "condition": { "$ref": "#/$defs/condition" }
          }
        }
      ]
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["const"],
          "properties": {
            "const": { "type": ["string", "number", "boolean", "null"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref"],
          "properties": { "ref": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["sub"],
          "properties": {
            "sub": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "$ref": "#/$defs/expression" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mul"],
          "properties": {
            "mul": {
              "type": "array",
              "minItems": 2,
              "items": { "$ref": "#/$defs/expression" }
            }
          }
        }
      ]
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "target", "value"],
          "properties": {
            "kind": { "const": "set" },
            "target": { "type": "string", "minLength": 1 },
            "value": { "$ref": "#/$defs/expression" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "target", "value"],
          "properties": {
            "kind": { "const": "set_x" },
            "target": { "type": "string", "minLength": 1 },
            "value": { "$ref": "#/$defs/expression" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "target", "animation", "from_frame"],
          "properties": {
            "kind": { "const": "set_animation" },
            "target": { "type": "string", "minLength": 1 },
            "animation": { "type": "string", "minLength": 1 },
            "from_frame": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    }
  }
}
